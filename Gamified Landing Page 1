<!-- XP NOTIFICATION -->

<div class="xp-popup" id="xpPopup">
    +50 XP Earned!
</div>


<script>

/* ==========================================
   PATHKEEPER GAME SYSTEM
========================================== */

const questXP = {
    postmortem:50,
    skills:75,
    evidence:100,
    risk:50,
    capital:75,
    resilience:75,
    repository:100,
    community:50
};

const savedXP = parseInt(localStorage.getItem("pathkeeperXP")) || 0;

const savedQuests =
    JSON.parse(localStorage.getItem("pathkeeperQuests")) || [];

let xp = savedXP;
let completedQuests = savedQuests;

let dailyComplete =
    localStorage.getItem("pathkeeperDaily") === "true";

let streak =
    parseInt(localStorage.getItem("pathkeeperStreak")) || 0;


/* ==========================================
   LEVEL SYSTEM
========================================== */

function getLevel(){

    return Math.floor(xp / 100) + 1;

}

function getCurrentLevelXP(){

    return xp % 100;

}


/* ==========================================
   UPDATE DASHBOARD
========================================== */

function updateDashboard(){

    const level = getLevel();
    const levelXP = getCurrentLevelXP();

    document.getElementById("levelBadge").textContent =
        "LEVEL " + level;

    document.getElementById("xpText").textContent =
        levelXP + " / 100";

    document.getElementById("xpFill").style.width =
        levelXP + "%";


    document.getElementById("completedText").textContent =
        completedQuests.length + " / 8";


    document.getElementById("streakText").textContent =
        streak + " 🔥";


    const score =
        Math.round((completedQuests.length / 8) * 100);

    document.getElementById("scoreText").textContent =
        score + "%";

    document.getElementById("scoreCircle").textContent =
        score + "%";


    updateBadges();

    updatePath();

}


/* ==========================================
   ADD XP
========================================== */

function addXP(amount){

    const oldLevel = getLevel();

    xp += amount;

    localStorage.setItem(
        "pathkeeperXP",
        xp
    );

    const newLevel = getLevel();

    showXPPopup(
        "+" + amount + " XP Earned!"
    );

    if(newLevel > oldLevel){

        setTimeout(function(){

            showXPPopup(
                "🎉 LEVEL UP! You reached Level " +
                newLevel + "!"
            );

        },700);

    }

    updateDashboard();

}


/* ==========================================
   XP POPUP
========================================== */

function showXPPopup(message){

    const popup =
        document.getElementById("xpPopup");

    popup.textContent = message;

    popup.classList.add("show");

    setTimeout(function(){

        popup.classList.remove("show");

    },2200);

}


/* ==========================================
   QUEST COMPLETION
========================================== */

document.querySelectorAll(".quest-card").forEach(card => {

    const id = card.dataset.id;

    if(completedQuests.includes(id)){

        markQuestComplete(card);

    }


    card.addEventListener("click",function(){

        if(completedQuests.includes(id)){
            return;
        }

        completedQuests.push(id);

        localStorage.setItem(
            "pathkeeperQuests",
            JSON.stringify(completedQuests)
        );

        markQuestComplete(card);

        addXP(questXP[id]);

    });

});


function markQuestComplete(card){

    card.classList.add("completed");

    const status =
        card.querySelector(".quest-status");

    status.textContent =
        "✓ Completed";

}


/* ==========================================
   DAILY MISSION
========================================== */

if(dailyComplete){

    const button =
        document.getElementById("dailyMissionButton");

    button.textContent =
        "✓ Mission Completed";

    button.classList.add("completed");

    button.disabled = true;

}


function completeDailyMission(){

    if(dailyComplete){
        return;
    }

    dailyComplete = true;

    localStorage.setItem(
        "pathkeeperDaily",
        "true"
    );

    streak++;

    localStorage.setItem(
        "pathkeeperStreak",
        streak
    );

    const button =
        document.getElementById("dailyMissionButton");

    button.textContent =
        "✓ Mission Completed";

    button.classList.add("completed");

    button.disabled = true;

    addXP(25);

}


/* ==========================================
   BADGES
========================================== */

function updateBadges(){

    const count =
        completedQuests.length;

    let badges = 0;


    if(count >= 1){

        document
            .getElementById("badgeFirst")
            .classList.add("unlocked");

        badges++;

    }


    if(count >= 3){

        document
            .getElementById("badgeBuilder")
            .classList.add("unlocked");

        badges++;

    }


    if(count >= 5){

        document
            .getElementById("badgeStrategist")
            .classList.add("unlocked");

        badges++;

    }


    if(count >= 8){

        document
            .getElementById("badgePathkeeper")
            .classList.add("unlocked");

        badges++;

    }


    document.getElementById("badgeText").textContent =
        badges + " / 4";

}


/* ==========================================
   PROGRESSION PATH
========================================== */

function updatePath(){

    const count =
        completedQuests.length;

    document.querySelectorAll(".path-stage")
        .forEach(stage => {

            stage.classList.remove("active");

        });


    if(count < 2){

        document
            .getElementById("stage1")
            .classList.add("active");

    }
    else if(count < 4){

        document
            .getElementById("stage2")
            .classList.add("active");

    }
    else if(count < 7){

        document
            .getElementById("stage3")
            .classList.add("active");

    }
    else{

        document
            .getElementById("stage4")
            .classList.add("active");

    }

}


/* ==========================================
   INITIALIZE
========================================== */

updateDashboard();

</script>

