<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PathKeeper | Opportunity Intelligence Center</title>

<style>
:root {
  --blue-dark: #233F5A;
  --blue: #527A9B;
  --blue-light: #DCE8F0;
  --blue-pale: #EDF3F7;

  --brown-dark: #3F3029;
  --brown: #654735;
  --brown-light: #8A6B52;
  --tan: #C5A16B;

  --cream: #F6F0E4;
  --cream-dark: #EAE0D0;
  --paper: #FFFCF5;

  --ink: #303944;
  --muted: #6C747C;
  --line: #DED8CD;
  --white: #FFFFFF;

  --shadow: 0 12px 35px rgba(35, 63, 90, 0.09);
  --radius: 17px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  background: var(--cream);
  color: var(--ink);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.65;
}

a {
  color: var(--blue-dark);
}

button,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.container {
  width: min(1160px, 92%);
  margin: auto;
}

.section {
  padding: 76px 0;
}

.section-light {
  background: var(--paper);
}

.section-blue {
  background: var(--blue-pale);
}

.section-brown {
  background: var(--brown-dark);
  color: var(--cream);
}

.eyebrow {
  display: inline-block;
  color: var(--brown);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.section-heading {
  max-width: 760px;
  margin-bottom: 35px;
}

.section-heading h2 {
  color: var(--blue-dark);
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.2;
  margin-bottom: 13px;
}

.section-heading p {
  color: var(--muted);
  font-size: 16px;
}

.section-brown .section-heading h2,
.section-brown .section-heading p {
  color: var(--cream);
}

.section-brown .eyebrow {
  color: var(--tan);
}

/* NAVIGATION */

.topbar {
  background: var(--blue-dark);
  color: white;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4px 15px rgba(0,0,0,.12);
}

.nav {
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.brand {
  color: var(--cream);
  text-decoration: none;
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 1px;
}

.brand span {
  color: var(--tan);
}

.nav-links {
  display: flex;
  flex-wrap: wrap;
  gap: 19px;
  align-items: center;
}

.nav-links a {
  color: #F4F0E8;
  text-decoration: none;
  font-size: 13px;
  font-weight: 700;
  transition: color .2s;
}

.nav-links a:hover {
  color: var(--tan);
}

/* HERO */

.hero {
  background:
    radial-gradient(circle at 85% 15%, rgba(197,161,107,.18), transparent 30%),
    linear-gradient(120deg, #233F5A 0%, #365C78 58%, #654735 130%);
  color: white;
  padding: 100px 0 85px;
  overflow: hidden;
}

.hero-content {
  max-width: 850px;
}

.hero-label {
  display: inline-block;
  padding: 8px 14px;
  border: 1px solid rgba(255,255,255,.35);
  border-radius: 30px;
  color: #F0D6AE;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.5px;
  margin-bottom: 22px;
}

.hero h1 {
  font-size: clamp(36px, 6vw, 62px);
  line-height: 1.08;
  max-width: 850px;
  margin-bottom: 24px;
}

.hero h1 span {
  color: #E8C89A;
}

.hero p {
  max-width: 700px;
  color: #E5EAF0;
  font-size: 18px;
  margin-bottom: 30px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 21px;
  border-radius: 9px;
  text-decoration: none;
  font-size: 14px;
  font-weight: 800;
  border: 1px solid transparent;
  transition: transform .2s, background .2s;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-cream {
  background: var(--cream);
  color: var(--blue-dark);
}

.btn-outline {
  border-color: rgba(255,255,255,.6);
  color: white;
  background: transparent;
}

.btn-blue {
  background: var(--blue-dark);
  color: white;
}

.btn-brown {
  background: var(--brown);
  color: white;
}

/* INTRODUCTION */

.intro-grid {
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  gap: 30px;
  align-items: stretch;
}

.intro-copy {
  padding: 30px 0;
}

.intro-copy h2 {
  color: var(--blue-dark);
  font-size: 33px;
  line-height: 1.2;
  margin-bottom: 18px;
}

.intro-copy p {
  color: var(--muted);
  margin-bottom: 15px;
}

.principle-card {
  background: var(--blue-dark);
  color: white;
  border-radius: var(--radius);
  padding: 32px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: var(--shadow);
}

.principle-card .small-label {
  color: var(--tan);
  text-transform: uppercase;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 15px;
}

.principle-card h3 {
  font-size: 25px;
  line-height: 1.3;
  margin-bottom: 15px;
}

.principle-card p {
  color: #E3EAF0;
  font-size: 14px;
}

/* PATHWAY CARDS */

.pathway-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
}

.pathway-card {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 28px;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
}

.pathway-card:nth-child(2),
.pathway-card:nth-child(4) {
  border-top: 5px solid var(--brown);
}

.pathway-card:nth-child(1),
.pathway-card:nth-child(3) {
  border-top: 5px solid var(--blue);
}

.pathway-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: var(--blue-pale);
  display: grid;
  place-items: center;
  font-size: 23px;
  margin-bottom: 18px;
}

.pathway-card h3 {
  color: var(--blue-dark);
  font-size: 22px;
  margin-bottom: 10px;
}

.pathway-card p {
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 16px;
}

.pathway-card ul {
  padding-left: 19px;
  margin-bottom: 20px;
  color: var(--ink);
  font-size: 14px;
}

.pathway-card li {
  margin-bottom: 7px;
}

.pathway-card .btn {
  margin-top: auto;
  align-self: flex-start;
}

/* COMPARISON TABLE */

.table-wrap {
  overflow-x: auto;
  border-radius: 13px;
  border: 1px solid var(--line);
  background: var(--paper);
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 700px;
}

th {
  background: var(--blue-dark);
  color: white;
  text-align: left;
  padding: 17px;
  font-size: 13px;
}

td {
  padding: 16px 17px;
  border-bottom: 1px solid var(--line);
  color: var(--ink);
  font-size: 13px;
  vertical-align: top;
}

tr:last-child td {
  border-bottom: none;
}

tbody tr:nth-child(even) {
  background: #F7F3EB;
}

td strong {
  color: var(--brown);
}

/* OPPORTUNITY PROCESS */

.process-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 13px;
}

.process-step {
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.17);
  padding: 22px 16px;
  border-radius: 13px;
  text-align: center;
}

.process-number {
  width: 38px;
  height: 38px;
  margin: 0 auto 14px;
  display: grid;
  place-items: center;
  background: var(--tan);
  color: var(--brown-dark);
  font-weight: 900;
  border-radius: 50%;
}

.process-step h3 {
  font-size: 17px;
  color: #F2D5AA;
  margin-bottom: 8px;
}

.process-step p {
  color: #E2E4E7;
  font-size: 12px;
}

/* DETAIL SECTIONS */

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
}

.detail-card {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 27px;
}

.detail-card h3 {
  color: var(--blue-dark);
  font-size: 21px;
  margin-bottom: 13px;
}

.detail-card p {
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 12px;
}

.detail-card ul {
  padding-left: 19px;
  font-size: 14px;
}

.detail-card li {
  margin-bottom: 8px;
}

.evidence-list {
  display: grid;
  gap: 12px;
  margin-top: 17px;
}

.evidence-item {
  background: var(--blue-pale);
  border-left: 4px solid var(--brown-light);
  padding: 13px 15px;
  border-radius: 7px;
  font-size: 13px;
}

.evidence-item strong {
  display: block;
  color: var(--blue-dark);
  margin-bottom: 3px;
}

/* RESOURCE MATRIX */

.matrix-controls {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 15px;
  margin-bottom: 24px;
  background: var(--blue-pale);
  padding: 20px;
  border-radius: 13px;
}

.control-group label {
  display: block;
  color: var(--blue-dark);
  font-size: 12px;
  font-weight: 800;
  margin-bottom: 7px;
}

.control-group select {
  width: 100%;
  background: white;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 12px;
  color: var(--ink);
  outline-color: var(--blue);
}

.resource-name {
  color: var(--blue-dark);
  font-weight: 800;
}

.resource-link {
  display: inline-block;
  margin-top: 6px;
  font-size: 12px;
  font-weight: 800;
  text-decoration: none;
  color: var(--brown);
}

.resource-link:hover {
  text-decoration: underline;
}

#matrixCount {
  color: var(--muted);
  font-size: 13px;
  margin: 12px 0;
}

.no-results {
  display: none;
  background: var(--cream);
  padding: 22px;
  border-radius: 10px;
  color: var(--brown);
  text-align: center;
}

/* RESOURCE VAULT */

.vault-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.vault-card {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 15px;
  padding: 25px;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow);
}

.vault-card .vault-icon {
  font-size: 28px;
  margin-bottom: 13px;
}

.vault-card h3 {
  color: var(--blue-dark);
  font-size: 19px;
  margin-bottom: 10px;
}

.vault-card p {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 17px;
}

.vault-card a {
  margin-top: auto;
  color: var(--brown);
  font-size: 13px;
  font-weight: 800;
  text-decoration: none;
}

.vault-card a:hover {
  text-decoration: underline;
}

/* CHECKLIST */

.checklist-layout {
  display: grid;
  grid-template-columns: 1fr .8fr;
  gap: 28px;
  align-items: start;
}

.checklist-panel {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 28px;
}

.checklist-panel h3 {
  color: var(--blue-dark);
  font-size: 22px;
  margin-bottom: 18px;
}

.check-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid var(--line);
  font-size: 14px;
}

.check-item:last-child {
  border-bottom: none;
}

.check-item input {
  width: 18px;
  height: 18px;
  margin-top: 3px;
  accent-color: var(--blue-dark);
  flex-shrink: 0;
}

.progress-panel {
  background: var(--blue-dark);
  color: white;
  border-radius: var(--radius);
  padding: 30px;
}

.progress-panel h3 {
  color: #E8C89A;
  font-size: 22px;
  margin-bottom: 12px;
}

.progress-panel p {
  color: #E3EAF0;
  font-size: 14px;
  margin-bottom: 20px;
}

.progress-number {
  font-size: 42px;
  font-weight: 900;
  margin-bottom: 10px;
}

.progress-track {
  height: 12px;
  border-radius: 30px;
  background: rgba(255,255,255,.2);
  overflow: hidden;
  margin-bottom: 18px;
}

.progress-fill {
  height: 100%;
  width: 0%;
  background: var(--tan);
  border-radius: 30px;
  transition: width .3s ease;
}

.progress-status {
  color: #F0D6AE;
  font-size: 13px;
  margin-bottom: 20px;
}

.reset-button {
  border: 1px solid rgba(255,255,255,.55);
  background: transparent;
  color: white;
  border-radius: 8px;
  padding: 10px 15px;
  font-weight: 700;
  font-size: 12px;
}

/* RESOURCE INDEX */

.index-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.index-group {
  background: var(--paper);
  padding: 20px;
  border-radius: 12px;
  border: 1px solid var(--line);
}

.index-group h3 {
  color: var(--blue-dark);
  font-size: 16px;
  margin-bottom: 12px;
}

.index-group a {
  display: block;
  color: var(--brown);
  font-size: 12px;
  text-decoration: none;
  margin-bottom: 9px;
  font-weight: 700;
}

.index-group a:hover {
  text-decoration: underline;
}

/* FOOTER */

.footer {
  background: var(--brown-dark);
  color: var(--cream);
  padding: 35px 0;
}

.footer-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 15px;
}

.footer strong {
  color: var(--tan);
  font-size: 20px;
}

.footer p {
  color: #D9D0C7;
  font-size: 12px;
}

/* RESPONSIVE */

@media(max-width: 850px) {
  .nav {
    padding: 15px 0;
    align-items: flex-start;
    flex-direction: column;
  }

  .nav-links {
    gap: 12px;
  }

  .intro-grid,
  .detail-grid,
  .checklist-layout {
    grid-template-columns: 1fr;
  }

  .process-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .vault-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .index-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media(max-width: 580px) {
  .section {
    padding: 52px 0;
  }

  .hero {
    padding: 70px 0;
  }

  .hero p {
    font-size: 16px;
  }

  .nav-links {
    gap: 9px 14px;
  }

  .nav-links a {
    font-size: 11px;
  }

  .pathway-grid,
  .vault-grid,
  .matrix-controls,
  .index-grid {
    grid-template-columns: 1fr;
  }

  .process-grid {
    grid-template-columns: 1fr 1fr;
  }

  .pathway-card,
  .detail-card {
    padding: 22px;
  }

  .footer-content {
    align-items: flex-start;
    flex-direction: column;
  }
}
</style>
</head>

<body>

<!-- NAVIGATION -->
<header class="topbar">
  <div class="container nav">
    <a class="brand" href="#home">PATH<span>KEEPER</span></a>

    <nav class="nav-links" aria-label="Main navigation">
      <a href="#overview">Overview</a>
      <a href="#pathways">Pathways</a>
      <a href="#education">Education</a>
      <a href="#career">Career</a>
      <a href="#business">Business</a>
      <a href="#matrix">Resource Matrix</a>
      <a href="#vault">Resource Vault</a>
    </nav>
  </div>
</header>

<main>

<!-- HERO -->
<section class="hero" id="home">
  <div class="container">
    <div class="hero-content">
      <div class="hero-label">PATHKEEPER OPPORTUNITY INTELLIGENCE</div>

      <h1>
        Build a Career Path That
        <span>You Control.</span>
      </h1>

      <p>
        Explore education, independent learning, career advancement,
        and entrepreneurship. Compare opportunities, identify resources,
        build practical skills, and turn what you learn into evidence
        that moves you forward.
      </p>

      <div class="hero-actions">
        <a class="btn btn-cream" href="#pathways">Explore Your Pathways</a>
        <a class="btn btn-outline" href="#matrix">Find Learning Resources</a>
      </div>
    </div>
  </div>
</section>

<!-- OVERVIEW -->
<section class="section section-light" id="overview">
  <div class="container">
    <div class="intro-grid">

      <div class="intro-copy">
        <span class="eyebrow">The Opportunity Intelligence Center</span>

        <h2>Opportunity is more than finding an opening. It is building the ability to use it.</h2>

        <p>
          A career path does not have to follow one traditional route.
          People can combine formal education, independent study,
          certifications, practical projects, work experience, funding,
          and business development.
        </p>

        <p>
          The goal is to identify what a particular opportunity requires,
          determine what resources are available, and build a realistic
          sequence of actions that moves you toward the outcome.
        </p>

        <p>
          PathKeeper organizes those decisions so that learning has a
          purpose, practice produces evidence, and evidence can support
          the next opportunity.
        </p>
      </div>

      <div class="principle-card">
        <div class="small-label">The PathKeeper Principle</div>

        <h3>Do not collect information without deciding what it will help you accomplish.</h3>

        <p>
          Connect every course, credential, project, and experience
          to a specific capability, requirement, or future opportunity.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- FOUR PATHWAYS -->
<section class="section" id="pathways">
  <div class="container">

    <div class="section-heading">
      <span class="eyebrow">Choose a direction</span>
      <h2>Four Ways to Build an Opportunity</h2>
      <p>
        These pathways can be pursued independently or combined.
        The right approach depends on your resources, timeline,
        financial situation, and intended outcome.
      </p>
    </div>

    <div class="pathway-grid">

      <article class="pathway-card">
        <div class="pathway-icon">🎓</div>
        <h3>Traditional Education</h3>

        <p>
          Use colleges, universities, professional programs,
          and recognized institutions to develop structured knowledge
          and earn formal credentials.
        </p>

        <ul>
          <li>Degrees and academic programs</li>
          <li>Scholarships and financial aid</li>
          <li>Professional certificates</li>
          <li>Internships and institutional networks</li>
          <li>Transferable academic credits</li>
        </ul>

        <a class="btn btn-blue" href="#education">Explore Education</a>
      </article>

      <article class="pathway-card">
        <div class="pathway-icon">📚</div>
        <h3>Self-Education</h3>

        <p>
          Create a structured learning program using free and
          affordable courses, books, research, practice,
          and independent projects.
        </p>

        <ul>
          <li>Online courses and tutorials</li>
          <li>Open educational resources</li>
          <li>Industry certifications</li>
          <li>Portfolio projects</li>
          <li>Independent research and practice</li>
        </ul>

        <a class="btn btn-brown" href="#self-education">Explore Self-Education</a>
      </article>

      <article class="pathway-card">
        <div class="pathway-icon">💼</div>
        <h3>Career Advancement</h3>

        <p>
          Develop capabilities that employers value, demonstrate
          measurable contributions, and prepare for better roles
          and increased responsibility.
        </p>

        <ul>
          <li>Skills gap analysis</li>
          <li>Workplace performance evidence</li>
          <li>Professional development</li>
          <li>Career transitions</li>
          <li>Promotion and specialization</li>
        </ul>

        <a class="btn btn-blue" href="#career">Explore Career Growth</a>
      </article>

      <article class="pathway-card">
        <div class="pathway-icon">🚀</div>
        <h3>Entrepreneurship</h3>

        <p>
          Build an independent source of opportunity by identifying
          problems, testing solutions, developing offers,
          and learning how to reach customers.
        </p>

        <ul>
          <li>Business research and validation</li>
          <li>Grants and funding research</li>
          <li>Business planning</li>
          <li>Digital products and services</li>
          <li>Customer acquisition</li>
        </ul>

        <a class="btn btn-brown" href="#business">Explore Entrepreneurship</a>
      </article>

    </div>
  </div>
</section>

<!-- COMPARISON -->
<section class="section section-light" id="comparison">
  <div class="container">

    <div class="section-heading">
      <span class="eyebrow">Evaluate before committing</span>
      <h2>Compare Your Opportunity Options</h2>
      <p>
        Each route has different costs, requirements, timelines,
        and forms of evidence. Compare the actual opportunity
        rather than assuming one route is always better.
      </p>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Pathway</th>
            <th>Primary Investment</th>
            <th>Possible Evidence</th>
            <th>Potential Advantages</th>
            <th>Considerations</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td><strong>Traditional Education</strong></td>
            <td>Tuition, time, application costs</td>
            <td>Degree, transcript, academic projects</td>
            <td>Structured instruction and recognized credentials</td>
            <td>Cost, admission requirements, program length</td>
          </tr>

