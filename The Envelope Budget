
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Envelope Budgeter | PathKeeper</title>

<style>
:root {
  --cream: #F7F2E8;
  --cream-dark: #EEE3D1;
  --brown: #49352A;
  --brown-light: #674C3B;
  --blue: #294F6D;
  --blue-light: #DCEAF1;
  --white: #FFFFFF;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--cream);
  color: var(--brown);
  line-height: 1.6;
  padding: 20px;
}

.container {
  max-width: 850px;
  margin: 30px auto;
  background: var(--white);
  padding: 30px;
  border-radius: 16px;
  box-shadow: 0 5px 20px rgba(73, 53, 42, 0.10);
}

header {
  text-align: center;
  margin-bottom: 30px;
}

header h1 {
  color: var(--blue);
  font-size: 2rem;
  margin-bottom: 10px;
}

header p {
  color: var(--brown-light);
}

h2 {
  color: var(--blue);
  margin: 25px 0 15px;
}

label {
  display: block;
  font-weight: bold;
  margin: 12px 0 6px;
}

input, select {
  width: 100%;
  padding: 12px;
  border: 1px solid #C9BBA9;
  border-radius: 7px;
  font-size: 1rem;
  background: var(--cream);
  color: var(--brown);
}

input:focus, select:focus {
  outline: 2px solid var(--blue);
  border-color: var(--blue);
}

fieldset {
  border: 1px solid #D8C9B7;
  border-radius: 10px;
  padding: 18px;
  margin: 20px 0;
}

legend {
  color: var(--blue);
  font-weight: bold;
  padding: 0 8px;
}

.input-container {
  margin-top: 10px;
}

button {
  border: none;
  border-radius: 8px;
  padding: 13px 20px;
  font-size: 1rem;
  font-weight: bold;
  cursor: pointer;
  margin: 8px 5px 8px 0;
  transition: 0.2s ease;
}

button:hover {
  opacity: 0.88;
  transform: translateY(-1px);
}

.primary-button {
  background: var(--blue);
  color: var(--white);
}

.secondary-button {
  background: var(--brown);
  color: var(--white);
}

.controls {
  margin: 20px 0;
  padding: 20px;
  background: var(--blue-light);
  border-radius: 10px;
}

.controls label {
  margin-top: 0;
}

.button-area {
  margin-top: 25px;
  text-align: center;
}

#output {
  margin-top: 25px;
  padding: 20px;
  background: var(--cream);
  border-radius: 10px;
}

.hide {
  display: none;
}

.action-planner-link {
  text-align: center;
  margin: 40px auto 15px;
  padding: 25px;
  background: var(--cream);
  border-radius: 12px;
}

.action-planner-link h2 {
  margin-top: 0;
}

.action-planner-link p {
  margin-bottom: 15px;
  color: var(--brown-light);
}

.action-planner-link a {
  display: inline-block;
  background: var(--brown);
  color: var(--cream);
  padding: 14px 28px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
}

.action-planner-link a:hover {
  background: var(--blue);
}

footer {
  text-align: center;
  margin-top: 30px;
  color: var(--brown-light);
  font-size: 0.85rem;
}

@media (max-width: 600px) {
  body {
    padding: 10px;
  }

  .container {
    padding: 18px;
    margin: 10px auto;
  }

  header h1 {
    font-size: 1.6rem;
  }

  button {
    width: 100%;
    margin: 6px 0;
  }
}
</style>
</head>

<body>

<div class="container">

<header>
  <h1>Envelope Budgeter</h1>
  <p>Organize your monthly income, assign expenses, and understand where your money goes.</p>
</header>

<form id="budget-form">

  <h2>Monthly Income</h2>

  <label for="income">Enter Your Monthly Income</label>
  <input
    type="number"
    id="income"
    min="0"
    placeholder="e.g. 2000"
    required
  >

  <h2>Monthly Expenses</h2>

  <fieldset id="rent">
    <legend>Rent</legend>
    <label for="rent-amount">Rent Amount</label>
    <input
      type="number"
      id="rent-amount"
      min="0"
      placeholder="Enter rent amount"
    >
  </fieldset>

  <fieldset id="food">
    <legend>Food</legend>
    <div class="input-container"></div>
  </fieldset>

  <fieldset id="utilities">
    <legend>Utilities</legend>
    <div class="input-container"></div>
  </fieldset>

  <fieldset id="entertainment">
    <legend>Entertainment</legend>
    <div class="input-container"></div>
  </fieldset>

  <div class="controls">

    <label for="entry-dropdown">Add Expense To:</label>

    <select id="entry-dropdown" name="options">
      <option value="food" selected>Food</option>
      <option value="utilities">Utilities</option>
      <option value="entertainment">Entertainment</option>
    </select>

    <button type="button" id="add-entry" class="primary-button">
      Add Expense
    </button>

  </div>

  <div class="button-area">

    <button type="submit" class="primary-button">
      Calculate Remaining Budget
    </button>

    <button type="button" id="clear" class="secondary-button">
      Clear
    </button>

  </div>

</form>

<div id="output" class="output hide"></div>

<!-- ACTION PLANNER LINK -->

<section class="action-planner-link">

  <h2>Turn Your Plans Into Actions</h2>

  <p>
    Organize your next steps, establish priorities,
    and create a practical plan for moving forward.
  </p>

  <a
    href="https://sites.google.com/view/pathkeeper/action-planner"
    target="_blank"
    rel="noopener noreferrer"
  >
    Open Action Planner
  </a>

</section>

<footer>
  <p>PathKeeper | Build Your Plan. Manage Your Resources. Move Forward.</p>
</footer>

</div>

<script>
const budgetForm = document.getElementById("budget-form");
const incomeInput = document.getElementById("income");
const rentInput = document.getElementById("rent-amount");
const entryDropdown = document.getElementById("entry-dropdown");
const addEntryButton = document.getElementById("add-entry");
const clearButton = document.getElementById("clear");
const output = document.getElementById("output");

let isError = false;

function cleanInputString(str) {
  const regex = /[+-\s]/g;
  return str.replace(regex, "");
}

function isInvalidInput(str) {
  const regex = /\d+e\d+/i;
  return str.match(regex);
}

function addEntry() {
  const category = entryDropdown.value;

  const targetInputContainer = document.querySelector(
    `#${category} .input-container`
  );

  const entryNumber = targetInputContainer.querySelectorAll(
    'input[type="text"]'
  ).length;

  const HTMLString = `
    <label for="${category}-${entryNumber}-name">
      Expense ${entryNumber} Name
    </label>
    <input
      type="text"
      placeholder="Name"
      id="${category}-${entryNumber}-name"
    >
    <label for="${category}-${entryNumber}-amount">
      Expense ${entryNumber} Amount
    </label>
  `;
}
</script>

</body>
</html>
