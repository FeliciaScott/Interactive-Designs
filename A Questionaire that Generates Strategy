     <p><strong>Recovery:</strong> ${escapeHTML(b.recovery)}</p>
    </div>`).join("")}
   <h3>Recovery checklist</h3>
   <ul>
    <li>Save a dated backup of the page inventory and URLs.</li>
    <li>Keep working code and source content before major changes.</li>
    <li>Test key links and pages after publishing.</li>
    <li>Reduce scope if deadlines repeatedly slip.</li>
    <li>Review this plan weekly and after major changes.</li>
   </ul>
  </div>`;
 report.scrollIntoView({behavior:"smooth",block:"start"});
}

/* ----------------------------------------------------
   DOWNLOADS
---------------------------------------------------- */

function downloadFile(filename,content,type){
 const blob=new Blob([content],{type});
 const url=URL.createObjectURL(blob);
 const a=document.createElement("a");
 a.href=url;a.download=filename;
 document.body.appendChild(a);a.click();a.remove();
 setTimeout(()=>URL.revokeObjectURL(url),1000);
}

let latestAnswers=null;
let latestStrategy=null;
let latestBackup=null;
let latestResults=null;

function makeJsonBackup(a,s,b){
 return {
  application:"PathKeeper Strategy & Contingency Planner",
  schemaVersion:1,
  exportedAt:new Date().toISOString(),
  answers:a,
  answeredQuestions:nonEmptyAnswers(a),
  strategy:s,
  contingencyPlan:b
 };
}

function generate(){
 const form=document.getElementById("questionnaire");
 if(!form.reportValidity())return;
 const a=getAnswers();
 const s=makeStrategy(a);
 const strategyText=buildStrategyText(a,s);
 const backupText=buildBackupText(a,s);
 latestAnswers=a;
 latestStrategy=strategyText;
 latestBackup=backupText;
 latestResults=makeJsonBackup(a,s,backupText);
 renderReport(a,s);
}

document.getElementById("generate").addEventListener("click",generate);

document.getElementById("saveProgress").addEventListener("click",()=>{
 const a=getAnswers();
 const payload={
  application:"PathKeeper Strategy & Contingency Planner",
  schemaVersion:1,
  exportedAt:new Date().toISOString(),
  answers:a
 };
 downloadFile("pathkeeper-questionnaire-backup.json",
  JSON.stringify(payload,null,2),"application/json");
});

document.getElementById("downloadStrategy").addEventListener("click",()=>{
 if(!latestStrategy){generate();if(!latestStrategy)return;}
 downloadFile("pathkeeper-strategy.txt",latestStrategy,"text/plain;charset=utf-8");
});
document.getElementById("downloadBackup").addEventListener("click",()=>{
 if(!latestBackup){generate();if(!latestBackup)return;}
 downloadFile("pathkeeper-contingency-plan.txt",latestBackup,"text/plain;charset=utf-8");
});
document.getElementById("downloadAll").addEventListener("click",()=>{
 if(!latestStrategy){generate();if(!latestStrategy)return;}
 downloadFile("pathkeeper-complete-plan.txt",
  latestStrategy+"\n\n"+latestBackup,"text/plain;charset=utf-8");
});
document.getElementById("downloadJson").addEventListener("click",()=>{
 if(!latestResults){generate();if(!latestResults)return;}
 downloadFile("pathkeeper-strategy-backup.json",
  JSON.stringify(latestResults,null,2),"application/json");
});
document.getElementById("printReport").addEventListener("click",()=>{
 if(!latestStrategy){generate();if(!latestStrategy)return;}
 window.print();
});

/* ----------------------------------------------------
   LOCAL DRAFT RECOVERY
---------------------------------------------------- */

const DRAFT_KEY="pathkeeper-strategy-questionnaire-v1";

function restoreDraft(){
 try{
  const saved=localStorage.getItem(DRAFT_KEY);
  if(!saved)return;
  const parsed=JSON.parse(saved);
  if(!parsed||typeof parsed!=="object")return;
  allQuestions.forEach(q=>{
   const el=document.getElementById(q.id);
   if(el&&typeof parsed[q.id]==="string")el.value=parsed[q.id];
  });
 }catch(error){
  console.warn("A saved draft could not be restored.",error);
 }
}

let saveTimer;
document.getElementById("questionnaire").addEventListener("input",()=>{
 clearTimeout(saveTimer);
 saveTimer=setTimeout(()=>{
  try{localStorage.setItem(DRAFT_KEY,JSON.stringify(getAnswers()));}
  catch(error){
   document.getElementById("answerCount").textContent=
    "Browser storage is unavailable. Download a backup to preserve answers.";
  }
 },250);
});

restoreDraft();
updateProgress();
</script>
