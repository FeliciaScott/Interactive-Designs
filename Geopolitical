<script>
/* =====================================
   RESOURCE MATRIX FILTERING
===================================== */

const industryFilter = document.getElementById("industryFilter");
const outputFilter = document.getElementById("outputFilter");
const levelFilter = document.getElementById("levelFilter");

const resourceRows = Array.from(
  document.querySelectorAll("#resourceTable tbody tr")
);

const matrixCount = document.getElementById("matrixCount");
const noResults = document.getElementById("noResults");

function filterResources() {
  const industry = industryFilter.value;
  const output = outputFilter.value;
  const level = levelFilter.value;

  let visibleCount = 0;

  resourceRows.forEach(row => {
    const matchesIndustry =
      industry === "all" ||
      row.dataset.industry === industry;

    const matchesOutput =
      output === "all" ||
      row.dataset.output === output;

    const matchesLevel =
      level === "all" ||
      row.dataset.level === level;

    const isVisible =
      matchesIndustry &&
      matchesOutput &&
      matchesLevel;

    row.style.display = isVisible ? "" : "none";

    if (isVisible) {
      visibleCount++;
    }
  });

  matrixCount.textContent =
    `Showing ${visibleCount} of ${resourceRows.length} resources.`;

  noResults.style.display =
    visibleCount === 0 ? "block" : "none";
}

industryFilter.addEventListener("change", filterResources);
outputFilter.addEventListener("change", filterResources);
levelFilter.addEventListener("change", filterResources);

filterResources();


/* =====================================
   CHECKLIST PROGRESS
===================================== */

const checkboxes = Array.from(
  document.querySelectorAll(".task-check")
);

const progressNumber = document.getElementById("progressNumber");
const progressFill = document.getElementById("progressFill");
const progressStatus = document.getElementById("progressStatus");
const progressBar = document.getElementById("progressBar");
const resetChecklist = document.getElementById("resetChecklist");

function updateProgress() {
  const completed = checkboxes.filter(
    checkbox => checkbox.checked
  ).length;

  const total = checkboxes.length;

  const percentage = total > 0
    ? Math.round((completed / total) * 100)
    : 0;

  progressNumber.textContent = percentage + "%";
  progressFill.style.width = percentage + "%";

  progressBar.setAttribute("aria-valuenow", percentage);

  if (percentage === 100) {
    progressStatus.textContent =
      "All checklist tasks completed. Review your research and decide on your next action.";
  } else if (percentage >= 70) {
    progressStatus.textContent =
      "Strong progress. Review the remaining tasks before committing.";
  } else if (percentage >= 30) {
    progressStatus.textContent =
      "You are building your opportunity foundation. Keep going.";
  } else if (percentage > 0) {
    progressStatus.textContent =
      "You have started. Continue researching your requirements.";
  } else {
    progressStatus.textContent =
      "Start with your goal and research requirements.";
  }
}

checkboxes.forEach(checkbox => {
  checkbox.addEventListener("change", updateProgress);
});

resetChecklist.addEventListener("click", () => {
  checkboxes.forEach(checkbox => {
    checkbox.checked = false;
  });

  updateProgress();
});

updateProgress();
</script>

