   <p><strong>Fallback:</strong> ${escapeHTML(a.fallback||"Not defined")}</p>
   ${s.backup.map((b,i)=>`
    <div style="margin:15px 0;border-top:1px solid #dce3da;padding-top:12px">
     <h3>${i+1}. ${escapeHTML(b.risk)}</h3>
