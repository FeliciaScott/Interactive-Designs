
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>PathKeeper Editing Center</title>
<style>
:root{--green:#153b2e;--green2:#285740;--cream:#f7f4eb;--paper:#fffdf8;--brown:#6e4b35;--gold:#d9b68c;--line:#d9e0d8;--ink:#24332b}
*{box-sizing:border-box}
body{margin:0;background:var(--cream);color:var(--ink);font:15px/1.5 Arial,sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer;border:0;border-radius:8px;padding:10px 13px;background:var(--green);color:white;font-weight:bold}
button:hover{opacity:.86}
.secondary{background:#e5ece5;color:var(--green)}
.danger{background:#a83d36}
input,select,textarea{width:100%;border:1px solid #cbd6cc;border-radius:7px;padding:10px;background:white;color:var(--ink)}
textarea{min-height:90px;resize:vertical}
.wrap{max-width:1450px;margin:auto;padding:20px}
.hero{background:linear-gradient(120deg,var(--green),var(--green2));color:white;padding:26px;border-radius:16px;margin-bottom:15px}
.hero small{color:var(--gold);font-weight:bold;letter-spacing:2px}
h1{font-size:clamp(28px,4vw,42px);margin:8px 0}
h2{font-size:20px;margin:0 0 12px}
h3{font-size:15px;margin:0 0 8px}
p{margin:7px 0}
.muted{color:#68766c;font-size:12px}
.hero p{max-width:750px;color:#e5eee6}
.actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}
.actions button{font-size:12px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:15px 0}
.stat,.panel{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:15px}
.stat strong{display:block;font-size:27px;color:var(--green)}
.stat span{font-size:12px;color:#68766c}
.layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,.8fr);gap:15px;align-items:start}
.panel{margin-bottom:15px}
.filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px;margin:12px 0}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}
.tabs button{font-size:11px}
.tabs .active{background:var(--gold);color:#2b251f}
.tablebox{overflow:auto;border:1px solid var(--line);border-radius:8px}
table{border-collapse:collapse;width:100%;min-width:680px;background:white}
th,td{text-align:left;padding:10px;border-bottom:1px solid #e6ece6;vertical-align:top}
th{background:#eaf0e9;font-size:11px;text-transform:uppercase}
td{font-size:12px}
.name{font-weight:bold;color:var(--green)}
.pill{display:inline-block;background:#e5ece5;color:#345641;padding:3px 7px;border-radius:20px;font-size:10px;font-weight:bold}
.pill.Merge,.pill.Remove,.pill.Delete{background:#f5e4e0;color:#923d34}
.pill.Review{background:#fff0ce;color:#79571d}
.pill.Move,.pill.Create{background:#e2ebfa;color:#345780}
.rowbuttons{display:flex;gap:5px;flex-wrap:wrap;margin-top:12px}
.rowbuttons button{font-size:11px;padding:7px 9px}
.field{margin-bottom:11px}
.field label{display:block;font-size:12px;font-weight:bold;margin-bottom:4px;color:#4b5e51}
.notice{background:#fff0ce;color:#694b15;padding:10px;border-radius:7px;font-size:12px;margin:10px 0}
.good{background:#e4f1e6;color:#28543a}
.hidden{display:none!important}
.queuegrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.queue{border:1px solid var(--line);background:white;padding:10px;border-radius:8px}
.queue strong{display:block;font-size:21px;color:var(--green)}
.queue span{font-size:11px}
.check{display:flex;gap:8px;margin:9px 0;font-size:13px}
.check input{width:auto}
.evidence{background:#edf2ec;padding:8px;border-radius:7px;margin:6px 0;font-size:12px;overflow-wrap:anywhere}
footer{font-size:12px;color:#68766c;padding:10px 0}
@media(max-width:850px){.layout{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.wrap{padding:10px}.filters{grid-template-columns:1fr}.queuegrid{grid-template-columns:repeat(2,1fr)}.hero{padding:18px}}
</style>
</head>
<body>
<div class="wrap">
<header class="hero">
<small>PATHKEEPER · WEBSITE MAINTENANCE</small>
<h1>Editing Control Center</h1>
<p>Organize pages, identify duplicates, record decisions, plan edits, track proof of work, and find the next task without digging through your original inventory.</p>
<div class="actions">
<button onclick="exportJSON()">Export Backup</button>
<button onclick="exportCSV()">Export Spreadsheet</button>
<button onclick="document.getElementById('file').click()">Import File</button>
<input hidden id="file" type="file" accept=".json,.csv,.txt,.md" onchange="readFile(event)">
</div>
</header>

<div class="stats">
<div class="stat"><strong id="total">0</strong><span>Page records</span></div>
<div class="stat"><strong id="done">0</strong><span>Completed</span></div>
<div class="stat"><strong id="todo">0</strong><span>Needs decisions</span></div>
<div class="stat"><strong id="problems">0</strong><span>Quality flags</span></div>
</div>

<div class="layout">
<main>
<section class="panel">
<h2>Page inventory</h2>
<p class="muted">Search, filter, sort, and open any record to edit it.</p>
<div class="filters">
<input id="search" placeholder="Search page names, notes, URLs…" oninput="render()">
<select id="actionFilter" onchange="render()">
<option value="">Every action</option>
<option>Keep</option><option>Review</option><option>Move</option>
<option>Merge</option><option>Create</option><option>Remove</option><option>Delete</option>
</select>
<select id="statusFilter" onchange="render()">
<option value="">Every status</option>
<option>Not started</option><option>In progress</option>
<option>Blocked</option><option>Complete</option>
</select>
</div>
<div class="tabs">
<button class="active" data-view="all" onclick="view('all',this)">All pages</button>
<button class="secondary" data-view="work" onclick="view('work',this)">Unfinished</button>
<button class="secondary" data-view="review" onclick="view('review',this)">Decisions first</button>
<button class="secondary" data-view="duplicates" onclick="view('duplicates',this)">Duplicates</button>
</div>
<p class="muted" id="count"></p>
<div class="tablebox">
<table>
<thead><tr><th>Page</th><th>Parent</th><th>Action</th><th>Status</th><th>Edit</th></tr></thead>
<tbody id="rows"></tbody>
</table>
</div>
<div class="rowbuttons">
<button onclick="addPage()">+ New Page</button>
<button class="secondary" onclick="issueReport()">Download Error Report</button>
<button class="secondary" onclick="clearFilters()">Clear Filters</button>
</div>
</section>

<section class="panel">
<h2>Work queues</h2>
<p class="muted">Counts update as you edit records.</p>
<div class="queuegrid" id="queues"></div>
</section>

<section class="panel">
<h2>Import inventory</h2>
<p class="muted">Paste JSON, CSV, or your existing inventory text. Preview it before choosing whether to replace or append records.</p>
<textarea id="paste" placeholder="Paste inventory text here…"></textarea>
<div class="rowbuttons">
<button onclick="previewImport()">Preview Import</button>
<button class="secondary" onclick="document.getElementById('paste').value=''">Clear</button>
</div>
<div id="preview" class="notice hidden"></div>
<div id="importButtons" class="rowbuttons hidden">
<button onclick="applyImport('replace')">Replace Inventory</button>
<button class="secondary" onclick="applyImport('append')">Add Records</button>
</div>
</section>
</main>

<aside>
<section class="panel" id="editor">
<h2>Page editor</h2>
<div id="empty" class="muted">Select Edit beside a page to open its details.</div>
<form id="form" class="hidden" onsubmit="save(event)">
<input type="hidden" id="id">
<div class="field"><label>Page name</label><input id="name" required></div>
<div class="field"><label>Parent / destination</label><input id="parent" list="parentList" placeholder="Home, Education, Resource Vault…"><datalist id="parentList"></datalist></div>
<div class="field"><label>Proposed action</label>
<select id="action"><option>Keep</option><option>Review</option><option>Move</option><option>Merge</option><option>Create</option><option>Remove</option><option>Delete</option></select></div>
<div class="field"><label>Work status</label>
<select id="status"><option>Not started</option><option>In progress</option><option>Blocked</option><option>Complete</option></select></div>
<div class="field"><label>Published page URL</label><input id="url" type="url" placeholder="https://sites.google.com/view/…"></div>
<div class="field"><label>Next editing steps</label><textarea id="steps" placeholder="1. Open the page&#10;2. Make the changes&#10;3. Test all links"></textarea></div>
<div class="field"><label>Decision notes / merge destination</label><textarea id="notes" placeholder="What should be preserved? Which page receives the content? What remains undecided?"></textarea></div>
<div class="field"><label>Upload screenshots as proof of work</label><input id="images" type="file" accept="image/*" multiple><p class="muted">Attach before/after screenshots. Export JSON to keep the images with the record.</p></div>
<div id="evidence"></div>
<div class="rowbuttons">
<button type="submit">Save Record</button>
<button type="button" class="secondary" onclick="duplicatePage()">Duplicate</button>
<button type="button" class="danger" onclick="removePage()">Remove Record</button>
</div>
</form>
</section>

<section class="panel">
<h2>Quality checks</h2>
<p class="muted">Flags identify missing information and potential conflicts. They do not automatically delete pages.</p>
<div id="issueList"></div>
</section>

<section class="panel">
<h2>Editing checklist</h2>
<label class="check"><input type="checkbox"> <span>Confirm the correct live page.</span></label>
<label class="check"><input type="checkbox"> <span>Choose a destination for moved or merged content.</span></label>
<label class="check"><input type="checkbox"> <span>Check every button and link.</span></label>
<label class="check"><input type="checkbox"> <span>Capture a screenshot after publishing.</span></label>
<label class="check"><input type="checkbox"> <span>Export a backup after editing.</span></label>
<div class="notice">This is an editing workspace, not a direct Google Sites editor. Changes here do not change your published site.</div>
</section>
</aside>
</div>
<footer>PathKeeper Editing Control Center · Working inventory only · Export your backup regularly.</footer>
</div>

<script>
// Starter records extracted from the supplied inventory.
// Each row is [page name, proposed parent, proposed action].
const seed = STARTER_DATA;

let pages = load() || seed.map((r,i)=>({
 id:String(i+1),name:r[0],parent:r[1],action:r[2],
 status:"Not started",url:"",steps:"",notes:"",evidence:[]
}));
let selected=null, mode="all", pending=[];

function uid(){return "p"+Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
function load(){try{return JSON.parse(localStorage.getItem("pk-editor-v1"))}catch(e){return null}}
function persist(){try{localStorage.setItem("pk-editor-v1",JSON.stringify(pages))}catch(e){}}
function esc(s=""){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function norm(s){return String(s||"").toLowerCase().replace(/[^a-z0-9]+/g," ").trim()}
function dupGroups(){
 const map={};
 pages.forEach(p=>{let k=norm(p.name);if(k)(map[k] ||= []).push(p)});
 return Object.values(map).filter(g=>g.length>1);
}
function issues(p){
 let out=[];
 if(!p.name?.trim())out.push("Missing page name");
 if(!p.parent?.trim())out.push("Missing parent section");
 if(!p.url?.trim()&&p.action!=="Create")out.push("URL not recorded");
 if(["Merge","Move","Remove","Delete"].includes(p.action)&&!p.notes?.trim()&&!p.steps?.trim())out.push("Needs destination or decision notes");
 if(p.action==="Create"&&!p.steps?.trim())out.push("Needs a build plan");
 return out;
}
function allIssues(){
 let out=[];
 pages.forEach(p=>issues(p).forEach(x=>out.push({id:p.id,name:p.name,msg:x})));
 dupGroups().forEach(g=>g.forEach(p=>out.push({id:p.id,name:p.name,msg:"Possible duplicate name"})));
 return out;
}
function view(v,b){
 mode=v;
 document.querySelectorAll("[data-view]").forEach(x=>x.classList.toggle("active",x===b));
 document.querySelectorAll("[data-view]").forEach(x=>x.classList.toggle("secondary",x!==b));
 render();
}
function clearFilters(){
 ["search","actionFilter","statusFilter"].forEach(x=>document.getElementById(x).value="");
 mode="all";
 document.querySelectorAll("[data-view]").forEach(x=>{
  x.classList.toggle("active",x.dataset.view==="all");
  x.classList.toggle("secondary",x.dataset.view!=="all");
 });
 render();
}
function render(){
 const q=norm(document.getElementById("search").value);
 const a=document.getElementById("actionFilter").value;
 const s=document.getElementById("statusFilter").value;
 const dupIds=new Set(dupGroups().flat().map(p=>p.id));
 let list=pages.filter(p=>{
  if(q&&!norm([p.name,p.parent,p.action,p.status,p.url,p.notes,p.steps].join(" ")).includes(q))return false;
  if(a&&p.action!==a)return false;
  if(s&&p.status!==s)return false;
  if(mode==="work"&&p.status==="Complete")return false;
  if(mode==="review"&&!["Review","Merge","Move","Remove","Delete"].includes(p.action))return false;
  if(mode==="duplicates"&&!dupIds.has(p.id))return false;
  return true;
 }).sort((x,y)=>x.name.localeCompare(y.name));

 document.getElementById("count").textContent=`Showing ${list.length} of ${pages.length} records`;
 document.getElementById("rows").innerHTML=list.map(p=>`
 <tr>
 <td><div class="name">${esc(p.name)}</div>
 <div class="muted">${p.url?`<a href="${esc(p.url)}" target="_blank" rel="noopener">Open live page ↗</a>`:"No URL recorded"}</div></td>
 <td>${esc(p.parent||"—")}</td>
 <td><span class="pill ${esc(p.action)}">${esc(p.action)}</span></td>
 <td>${esc(p.status)}</td>
 <td><button class="secondary" onclick="editPage('${p.id}')">Edit</button></td>
 </tr>`).join("")||'<tr><td colspan="5">No matching records.</td></tr>';

 document.getElementById("total").textContent=pages.length;
 document.getElementById("done").textContent=pages.filter(p=>p.status==="Complete").length;
 document.getElementById("todo").textContent=pages.filter(p=>["Review","Merge","Move","Remove","Delete"].includes(p.action)||p.status==="Blocked").length;
 document.getElementById("problems").textContent=allIssues().length;

 document.getElementById("queues").innerHTML=["Review","Move","Merge","Create","Keep","Remove"].map(a=>`
 <div class="queue"><strong>${pages.filter(p=>p.action===a).length}</strong><span>${a}</span></div>`).join("");

 const parents=[...new Set(pages.map(p=>p.parent).filter(Boolean))].sort();
 document.getElementById("parentList").innerHTML=parents.map(p=>`<option value="${esc(p)}">`).join("");

 const groups={};
 allIssues().forEach(x=>(groups[x.id] ||= {name:x.name,items:[]}).items.push(x.msg));
 document.getElementById("issueList").innerHTML=Object.keys(groups).length?
 `<div class="notice">${allIssues().length} review flags found.</div>`+
 Object.entries(groups).slice(0,18).map(([id,g])=>`
 <p class="muted"><a href="#" onclick="editPage('${id}');return false">${esc(g.name)}</a><br>${esc([...new Set(g.items)].join("; "))}</p>`).join("")+
 (Object.keys(groups).length>18?'<p class="muted">More flags available in the downloadable report.</p>':""):
 '<div class="notice good">No obvious inventory issues detected.</div>';
}
function editPage(id){
 const p=pages.find(x=>x.id===id);if(!p)return;
 selected=id;
 document.getElementById("empty").classList.add("hidden");
 document.getElementById("form").classList.remove("hidden");
 ["id","name","parent","action","status","url","steps","notes"].forEach(k=>document.getElementById(k).value=p[k]||"");
 showEvidence(p);
 document.getElementById("editor").scrollIntoView({behavior:"smooth",block:"start"});
}
function showEvidence(p){
 document.getElementById("evidence").innerHTML=(p.evidence||[]).map((e,i)=>`
 <div class="evidence">${esc(e.name)}
 <button type="button" class="secondary" onclick="removeEvidence(${i})">Remove</button>
 ${e.data?`<br><img src="${e.data}" alt="Proof of work" style="max-width:100%;margin-top:8px;border-radius:6px">`:""}
 </div>`).join("")||'<p class="muted">No screenshots attached.</p>';
}
async function save(ev){
 ev.preventDefault();
 const p=pages.find(x=>x.id===selected);if(!p)return;
 ["name","parent","action","status","url","steps","notes"].forEach(k=>p[k]=document.getElementById(k).value.trim());
 const files=[...document.getElementById("images").files];
 for(const f of files){
  if(f.size>1500000){alert(f.name+" is over 1.5 MB. Resize the screenshot before attaching it.");continue}
  const data=await new Promise(resolve=>{
   const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=()=>resolve("");
   r.readAsDataURL(f);
  });
  if(data)p.evidence.push({name:f.name,data,type:f.type});
 }
 document.getElementById("images").value="";
 persist();render();editPage(p.id);
 alert("Saved to this browser. Export a JSON backup to keep your changes.");
}
function addPage(){
 const p={id:uid(),name:"New page",parent:"Home",action:"Create",status:"Not started",url:"",steps:"Define purpose, content, links, and tests.",notes:"",evidence:[]};
 pages.unshift(p);persist();render();editPage(p.id);
}
function duplicatePage(){
 const p=pages.find(x=>x.id===selected);if(!p)return;
 const c={...p,id:uid(),name:p.name+" (copy)",status:"Not started",evidence:[]};
 pages.unshift(c);persist();render();editPage(c.id);
}
function removePage(){
 const p=pages.find(x=>x.id===selected);if(!p)return;
 if(!confirm("Remove this record from the working inventory? The live Google Sites page will not be deleted."))return;
 pages=pages.filter(x=>x.id!==selected);selected=null;
 document.getElementById("form").classList.add("hidden");
 document.getElementById("empty").classList.remove("hidden");
 persist();render();
}
function removeEvidence(i){
 const p=pages.find(x=>x.id===selected);if(!p)return;
 p.evidence.splice(i,1);persist();showEvidence(p);
}
function download(name,data,type){
 const url=URL.createObjectURL(new Blob([data],{type}));
 const a=document.createElement("a");a.href=url;a.download=name;a.click();
 setTimeout(()=>URL.revokeObjectURL(url),1000);
}
function exportJSON(){
 download("pathkeeper-backup.json",JSON.stringify({exportedAt:new Date().toISOString(),pages},null,2),"application/json");
}
function exportCSV(){
 const cols=["name","parent","action","status","url","steps","notes"];
 const cell=x=>'"'+String(x??"").replace(/"/g,'""')+'"';
 download("pathkeeper-inventory.csv",[cols.join(","),...pages.map(p=>cols.map(k=>cell(p[k])).join(","))].join("\r\n"),"text/csv");
}
function issueReport(){
 download("pathkeeper-quality-report.txt",["PATHKEEPER QUALITY REPORT",new Date().toLocaleString(),"",...allIssues().map(x=>`${x.name}: ${x.msg} [${x.id}]`)].join("\n"),"text/plain");
}
function parseCSV(s){
 const lines=s.trim().split(/\r?\n/);if(lines.length<2)return[];
 const headers=lines.shift().split(",").map(x=>norm(x).replace(/ /g,""));
 return lines.map(line=>{
  const cells=line.match(/("([^"]|"")*"|[^,]*)(,|$)/g)||[];
  const vals=cells.map(x=>x.replace(/,$/,"").replace(/^"|"$/g,"").replace(/""/g,'"'));
  const o={};headers.forEach((h,i)=>o[h]=vals[i]||"");
  return {name:o.name||"",parent:o.parent||"",action:o.action||"Review",status:o.status||"Not started",url:o.url||"",notes:o.notes||"",steps:o.steps||"",evidence:[]};
 }).filter(p=>p.name);
}
function parseInventory(raw){
 const t=raw.trim();if(!t)return[];
 try{
  const j=JSON.parse(t),arr=Array.isArray(j)?j:(j.pages||j.records||j.items||[]);
  if(arr.some(x=>x.name))return arr.map(p=>({...p,name:p.name||"",parent:p.parent||"",action:p.action||"Review",status:p.status||"Not started",url:p.url||"",notes:p.notes||"",steps:p.steps||"",evidence:p.evidence||[]}));
 }catch(e){}
 if(/(^|\n)\s*name\s*,/i.test(t))return parseCSV(t);
 const out=[],re=/\{\s*"name"\s*:\s*"([^"]*)"([\s\S]*?)\}/g;
 let m;
 while((m=re.exec(t))){
  const chunk=m[2];
  const val=k=>{const x=chunk.match(new RegExp('"'+k+'"\\s*:\\s*(?:"([^"]*)"|([^,\\n}\\s]+))'));return x?(x[1]??x[2]):""};
  out.push({name:m[1],parent:val("parent"),action:val("action")||"Review",status:val("status")||"Not started",url:val("url"),notes:"",steps:"",evidence:[]});
 }
 if(out.length)return out;
 return t.split(/\r?\n/).map(x=>x.trim()).filter(x=>x&&!x.startsWith("#")).map(name=>({name,parent:"",action:"Review",status:"Not started",url:"",notes:"",steps:"",evidence:[]}));
}
function previewImport(){
 pending=parseInventory(document.getElementById("paste").value);
 document.getElementById("preview").classList.remove("hidden");
 document.getElementById("preview").innerHTML=pending.length?
 `Found <b>${pending.length}</b> possible records. Preview: ${pending.slice(0,6).map(p=>esc(p.name)).join(", ")}. Check these names before importing.`:
 "No records found. Use JSON, CSV with a name column, or text containing page objects.";
 document.getElementById("importButtons").classList.toggle("hidden",!pending.length);
}
function applyImport(how){
 if(!pending.length)return;
 if(how==="replace"&&!confirm("Replace the current inventory? Export a backup first if you need to keep it."))return;
 const rows=pending.filter(p=>p.name).map(p=>({
  id:uid(),name:String(p.name).trim(),parent:p.parent||"",
  action:["Keep","Review","Move","Merge","Create","Remove","Delete"].includes(p.action)?p.action:"Review",
  status:["Not started","In progress","Blocked","Complete"].includes(p.status)?p.status:"Not started",
  url:p.url||"",notes:p.notes||"",steps:p.steps||"",evidence:p.evidence||[]
 }));
 pages=how==="append"?pages.concat(rows):rows;
 selected=null;persist();render();
 document.getElementById("preview").classList.add("hidden");
 document.getElementById("importButtons").classList.add("hidden");
 alert("Imported "+rows.length+" records. Check the quality flags and export a backup.");
}
function readFile(ev){
 const f=ev.target.files[0];if(!f)return;
 const r=new FileReader();r.onload=()=>{document.getElementById("paste").value=r.result;previewImport()};
 r.readAsText(f);ev.target.value="";
}
render();
</script>
</body>
</html>
